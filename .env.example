# 可选预设管理员；留空则首次访问 /admin/ 时创建。
AUTH_USER=admin
AUTH_PASSWORD=

# 必须替换为自有 HTTPS 域名；DNSPod A 记录指向部署主机内网 IP。
PUBLIC_HOST=gpt-pro.example.com
HTTPS_PORT=443
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=

# 网关明文入口只保留给本机管理和健康检查。
BIND_ADDR=127.0.0.1
HTTP_PORT=36090

# 管理员浏览器固定只绑定本机；只允许修改端口。
MAINTENANCE_PORT=36091

PUID=1000
PGID=1000
TZ=Asia/Shanghai
START_URL=https://chatgpt.com

# 自动探测不保存公网 IP；失败或禁用时使用下方部署值。
PROFILE_AUTO_DETECT=true
PROFILE_GEO_ENDPOINT=https://ipwho.is/?fields=success,country_code,timezone.id
PROFILE_GEO_TIMEOUT_MS=5000
PROFILE_TIMEZONE=
PROFILE_LOCALE=

# 全局代理；127.0.0.1 / localhost 会改写为 host.docker.internal。
PROXY_URL=

# Caddy 出口代理；必须填写容器可达的 http URL，留空则直连。
CADDY_PROXY_URL=

# 内部管理员浏览器凭据。
VNC_PASSWORD=gpc-internal

# 单文件与传输目录上限，单位为字节。
MAX_FILE_BYTES=536870912
TRANSFER_QUOTA_BYTES=4294967296

# 可见工作区帧率上限。
FRAME_ACTIVE_FPS=60
JPEG_QUALITY=72
