# 可选预设管理员；留空则首次访问 /admin/ 时创建。
AUTH_USER=admin
AUTH_PASSWORD=

# 校园内网可绑定 0.0.0.0；公网隧道应绑定 127.0.0.1。
BIND_ADDR=0.0.0.0
HTTP_PORT=36090

# 管理员浏览器默认只绑定本机；单独反代时填同主机名 HTTPS 地址。
MAINTENANCE_BIND_ADDR=127.0.0.1
MAINTENANCE_PORT=36091
MAINTENANCE_PUBLIC_URL=

PUID=1000
PGID=1000
TZ=Asia/Shanghai
START_URL=https://chatgpt.com

# 自动探测不保存公网 IP；失败或禁用时使用下方部署值。
PROFILE_AUTO_DETECT=true
PROFILE_GEO_ENDPOINT=https://ipwho.is/?fields=success,country_code,timezone.id
PROFILE_GEO_TIMEOUT_MS=5000
PROFILE_TIMEZONE=
PROFILE_LOCALE=

# 全局代理；127.0.0.1 / localhost 会改写为 host.docker.internal。
PROXY_URL=

# 内部管理员浏览器凭据。
VNC_PASSWORD=gpc-internal

# 单文件与传输目录上限，单位为字节。
MAX_FILE_BYTES=536870912
TRANSFER_QUOTA_BYTES=4294967296

# 前后台帧率上限与静止保活间隔。
FRAME_FPS=8
FRAME_ACTIVE_FPS=60
FRAME_IDLE_MS=2000
JPEG_QUALITY=72
